# Never prefix a private key with VITE_. Vite would expose it to browser code.
PATCH3Q_DEPLOYER_PRIVATE_KEY=0xYourFundedDianaEvmPrivateKey

# Alternative to the private key: a valid BIP-39 phrase for a funded unified QoreChain account.
# PATCH3Q_DEPLOYER_MNEMONIC=word1 word2 ... word24

# Optional. When omitted, the script deploys the permissionless MockTUSDT demo token first.
PATCH3Q_TUSDT_ADDRESS=0xExistingDianaTestToken

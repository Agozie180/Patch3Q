{
  "name": "patch3q",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Post-quantum vulnerability disclosure receipts on QoreChain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=60000",
    "test:contract": "hardhat test nodejs",
    "test:watch": "vitest",
    "compile:contract": "node scripts/compile-contract.mjs",
    "deploy:testnet": "pnpm compile:contract && node scripts/deploy-testnet.mjs",
    "audit:qcai": "pnpm compile:contract && node scripts/run-qcai-audit.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "verify:precompile": "node scripts/verify-pqc-precompile.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:contract && pnpm compile:contract && pnpm build"
  },
  "dependencies": {
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@qorechain/sdk": "0.14.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "~2.53.1",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "hardhat": "3.22.0",
    "solc": "0.8.30",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@coinbase/cdp-sdk>zod": "4.6.7",
      "@metamask/sdk>uuid": "11.1.1",
      "@metamask/sdk-communication-layer>uuid": "11.1.1",
      "@metamask/utils>uuid": "11.1.1",
      "@reown/appkit-wallet>zod": "4.6.7",
      "decode-uri-component": "0.5.1",
      "ws": "8.21.0"
    }
  }
}
